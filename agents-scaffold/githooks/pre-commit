#!/bin/sh
# Pre-commit: run the fast verify gate.
#
# Deliberately does NOT require a journal entry. A mandatory-artifact gate with
# an env-var escape hatch trains you to reach for the hatch, and a half-filled
# journal misrepresents the history — worse than no journal. git log is already
# an append-only per-change record. The journal stays a convention in AGENTS.md,
# where a human decides it's worth writing.
set -e

root=$(git rev-parse --show-toplevel)

. "$root/.githooks/lib-verify.sh"
if ! run_verify; then
	echo "pre-commit: verify failed — fix it or SKIP with the project's own escape hatch."
	exit 1
fi
