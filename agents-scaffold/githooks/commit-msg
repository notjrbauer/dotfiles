#!/bin/sh
# commit-msg: block AI attribution the harness defaults would inject
# (Co-Authored-By for AI, emoji banners). Agents never attribute AI;
# the owner adds an Assisted-by trailer manually when they choose.
msgfile="$1"

# Reject the AI Co-Authored-By trailer and "Generated with" banners —
# these are never wanted here.
if grep -qiE '^Co-Authored-By:.*(claude|anthropic|gpt|copilot|cursor)' "$msgfile"; then
	echo "commit-msg: no 'Co-Authored-By:' for AI — the owner attributes manually."
	exit 1
fi
if grep -qE 'Generated with|🤖' "$msgfile"; then
	echo "commit-msg: drop the emoji / 'Generated with' banner."
	exit 1
fi

# Attribution is optional and owner-added. If an Assisted-by trailer is
# present, both parts must be non-empty:  Assisted-by: NAME:MODEL
if grep -qiE '^Assisted-by:' "$msgfile" && ! grep -qE '^Assisted-by: .+:.+' "$msgfile"; then
	echo "commit-msg: malformed 'Assisted-by:' trailer."
	echo "  expected  Assisted-by: AGENT_NAME:MODEL_VERSION"
	exit 1
fi
exit 0
