#!/bin/sh
# commit-msg: block AI attribution the harness defaults would inject
# (Co-Authored-By for AI, emoji banners). Agents never attribute AI;
# the owner adds an Assisted-by trailer manually when they choose.
msgfile="$1"

# Check only the real message: cut at the `commit -v` scissors line, then
# strip comment lines — git removes both AFTER this hook runs, so grepping
# the raw file would false-positive on diff/comment content.
msg=$(sed -n '/^# ------------------------ >8 ------------------------$/q;p' "$msgfile" \
	| git stripspace --strip-comments)

# Reject the AI Co-Authored-By trailer and "Generated with" banners —
# these are never wanted here.
# Any trailer naming an AI, not only Co-Authored-By: a Signed-off-by for
# "Claude", or a Gemini/Codex co-author, is the same attribution by another
# header. noreply@anthropic.com is the address every Claude trailer carries.
if printf '%s\n' "$msg" | grep -qiE '^(Co-Authored-By|Signed-off-by|Reviewed-by|Assisted-by):.*(claude|anthropic|gpt|openai|codex|copilot|cursor|gemini|google\.com|devin|aider|windsurf|noreply@)'; then
	echo "commit-msg: no AI attribution trailer — the owner attributes manually."
	exit 1
fi
if printf '%s\n' "$msg" | grep -qE 'Generated with|🤖'; then
	echo "commit-msg: drop the emoji / 'Generated with' banner."
	exit 1
fi

# Attribution is optional and owner-added. If an Assisted-by trailer is
# present, both parts must be non-empty:  Assisted-by: NAME:MODEL
if printf '%s\n' "$msg" | grep -qiE '^Assisted-by:' \
	&& ! printf '%s\n' "$msg" | grep -qiE '^Assisted-by: .+:.+'; then
	echo "commit-msg: malformed 'Assisted-by:' trailer."
	echo "  expected  Assisted-by: AGENT_NAME:MODEL_VERSION"
	exit 1
fi
exit 0
