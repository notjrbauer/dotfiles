; vim: ft=gitconfig

[user]
    name = john bauer
    email = notjrbauer@gmail.com

[core]
    editor = nvim
	autocrlf = false
	pager = delta
	filemode = false
	untrackedCache = true

[gpg]
	program = gpg

[commit]
  verbose = true
  ;gpgsign = true

[branch]
  autosetupmerge = always
  autosetuprebase = always
  sort = -committerdate

[pull]
  rebase = true

[push]
  default = simple
  followTags = true
  autoSetupRemote = true

[fetch]
  prune = true

[rebase]
  autosquash = true
  instructionFormat = [%cn <%ce> %G?] %s
  autoStash = true
  updateRefs = true

[diff]
  # Detect copies as well as renames
  renames = copies
  algorithm = patience
  tool = nvimdiff
  indentHeuristic = true
  colorMoved = zebra

[difftool]
  prompt = false
  trustExitCode = true

[merge]
  # Include summaries of merged commits in newly created merge commit messages
  log = 1000
  tool = nvimdiff
	conflictStyle = zdiff3

[mergetool "nvimdiff"]
  cmd = nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c 'wincmd w' -c 'wincmd J'
  trustExitCode = true
  keepBackup = false

[log]
  decorate = short
  date = local

[status]
  submodulesummary = true
  color = true

[tag]
  ; forceSignAnnotated dropped: with no gpg key on a fresh machine it makes
  ; every `git tag -a` fail. Re-enable in ~/.gitconfig.local alongside a key.
  sort = version:refname

[apply]
  whitespace = nowarn

[color]
  ui = true

[alias]
  amend = commit --amend --no-edit
  force = push --force-with-lease
  fam = "!f() { git add . && git amend && git force; }; f"
  blm = blame -wMC
  br = branch --sort=-committerdate --verbose --format='%(HEAD) %(color:red)%(objectname:short)%(color:reset) - %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) - %(color:green)(%(committerdate:relative))%(color:reset) %(color:blue)<%(authorname)>%(color:reset)'
  brs = br -a
  cb = checkout -b
  cm = commit
  co = checkout
  d = diff --patch-with-stat
  dc = d --staged
  dm = d --word-diff-regex=.
  doctor = remote -v show origin
  fl = l -u
  stat = --no-pager diff --stat
  st = status -sb
  stashes = stash list

[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true

[rerere]
	enabled = true
	autoupdate = true

[column]
	ui = auto

[help]
	autocorrect = prompt

; Machine-local overrides LAST so they win — work identity, signing keys.
; Seeded by install.sh; never tracked. Keeps the personal email out of
; work-machine commits.
[include]
	path = ~/.gitconfig.local

; Identity by directory, applied AFTER .gitconfig.local so it beats the
; machine-wide default. Later blocks win, so the personal namespace carves
; itself back out of the work tree above it. Both target files are untracked:
; no employer name or work address ever lands in this public repo, and on a
; machine without them git silently ignores the missing include.
[includeIf "gitdir:~/dev/"]
	path = ~/.gitconfig.work
[includeIf "gitdir:~/dev/notjrbauer/"]
	path = ~/.gitconfig.personal
