#!/bin/sh
# tmux-agent-state — badge the tmux window an agent is working in.
#
#   tmux-agent-state running | done | wait | clear
#
# Sets (or unsets) the window option @agent, which .tmux.conf renders in
# window-status-format: red ! = this window wants you, green * = it finished
# while you were looking somewhere else. Driven by Claude Code hooks in
# .claude/settings.json — UserPromptSubmit -> running, Stop -> done,
# Notification -> wait.
#
# The bell in .tmux.conf is the floor for anything that only rings; this is the
# precise version, and it is what makes a background agent visible in the
# window list rather than only for the moment the bell sounded.
set -u

command -v tmux >/dev/null 2>&1 || exit 0
[ -n "${TMUX:-}" ] || exit 0

# Hooks and statusLine commands run as children of the pane's own process, so
# they inherit $TMUX_PANE. A background or dispatched session does not, so walk
# up the process tree until a PID matches a pane. (Note: contrary to a comment
# that used to be in ~/.claude/CLAUDE.md, $TMUX_PANE is populated in ordinary
# Bash tool calls too — but the walk costs nothing and covers the cases where
# it genuinely is not.)
pane="${TMUX_PANE:-}"
if [ -z "$pane" ]; then
    p=$PPID
    while [ "${p:-0}" -gt 1 ]; do
        pane=$(tmux list-panes -a -F '#{pane_id} #{pane_pid}' 2>/dev/null \
               | awk -v pid="$p" '$2 == pid { print $1; exit }')
        [ -n "$pane" ] && break
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
        [ -n "$p" ] || exit 0
    done
fi
[ -n "$pane" ] || exit 0

state=${1:-}

case "$state" in
    # Always unset, even on the window you are looking at: a "wait" you have
    # already answered must not outlive the answer.
    running|clear) tmux set-option -w -t "$pane" -u @agent 2>/dev/null ;;
    wait)
        tmux set-option -w -t "$pane" @agent wait 2>/dev/null
        # Desktop toast. Claude Code has no WezTerm notification channel, but
        # WezTerm renders OSC 777 as a system notification, and tmux forwards
        # it from the pane's tty when wrapped in a DCS passthrough
        # (allow-passthrough all in .tmux.conf — `on` forwards only from
        # visible panes, and a background window is the whole point).
        tty=$(tmux display-message -p -t "$pane" '#{pane_tty}' 2>/dev/null)
        where=$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null)
        [ -w "$tty" ] && printf '\033Ptmux;\033\033]777;notify;claude;needs you in %s\007\033\\' "$where" > "$tty"
        ;;
    done)
        # Never badge the window you are already staring at — a * on the
        # window you are reading is noise. window_active alone is not enough:
        # every session has a current window, so an agent finishing in the
        # current window of a session you are NOT attached to was never
        # badged. "Staring at" is active AND its session has a client.
        [ "$(tmux display-message -p -t "$pane" '#{&&:#{window_active},#{session_attached}}' 2>/dev/null)" = 1 ] && exit 0
        tmux set-option -w -t "$pane" @agent done 2>/dev/null ;;
    *) printf 'usage: %s running|done|wait|clear\n' "${0##*/}" >&2; exit 2 ;;
esac

# status-interval is 15s, and a badge that shows up a quarter-minute late is
# not an alert.
tmux refresh-client -S 2>/dev/null || true
exit 0
