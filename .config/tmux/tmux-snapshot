#!/bin/sh
# tmux-snapshot — save the shape of every tmux session, and put it back.
#
# What a snapshot holds: session names, window indexes and names, the layout
# string of each window, and every pane's working directory. What it
# deliberately does NOT hold: the programs that were running. Re-executing a
# recorded command line on restore is how tmux-resurrect surprises people —
# it will happily re-run a migration or a deploy. Panes come back as shells,
# in the right directory, and you restart what you meant to restart.
#
#   tmux-snapshot save          write a snapshot now
#   tmux-snapshot save auto     same, but refuse to record a server that is not
#                               yet as big as the file it would overwrite, and
#                               refuse outright on a scratch socket (see save())
#   tmux-snapshot restore       recreate every session the snapshot names and
#                               that does not already exist
#   tmux-snapshot path          print the snapshot path for this server
set -u

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tmux"

# Scope the state file to the server it describes. ~/.config/tmux is a symlink
# into the dotfiles repo, so EVERY tmux on this box loads the same .tmux.conf
# and runs this same script against the same $HOME. With one global path a
# throwaway `-L scratch` server took ownership of the real snapshot within a
# status tick, and the rotation below then pushed that junk into .prev as well
# — the file had no owner and whoever redrew a status line last won.
#
# An empty sock means there is no server to ask (an explicit save/restore from
# a plain shell, before anything is running), and the default server's file is
# the right target there. `display-message -p` needs no attached client and
# does not start a server, so this is safe to run unconditionally.
sock=$(tmux display-message -p '#{socket_path}' 2>/dev/null || printf '')
sock=${sock##*/}
case $sock in
    '' | default) snap="$state_dir/snapshot" ;;
    *)            snap="$state_dir/snapshot.$sock" ;;
esac

tab=$(printf '\t')
# Panes are recorded in tmux's own pane-index order, and restored in it. Do
# not "improve" this by sorting on pane_top/pane_left: select-layout maps a
# window's panes onto the layout string's cells in index order, and the cells
# are listed in tree-traversal order, which is only row-major by accident. A
# 2x2 grid built as one horizontal split with a vertical split in each half
# traverses column-major, so a visually-sorted snapshot restores that window
# with the two middle directories transposed.
#
# The window name is recorded as the sentinel ~auto~ whenever that window still
# has automatic-rename on. Two reasons, both bugs when it was #{window_name}
# flat. The name of an auto-renamed window is whatever command is running in
# it right now — a snapshot taken mid-`git push` recorded the window as "git"
# — so the recorded shape churned with ordinary work and the window-renamed
# hook rotated a good snapshot into .prev every time a command started. And on
# restore, `new-window -n git` turns automatic-rename OFF for that window, so a
# transient name became permanent. A sentinel rather than an empty field
# because IFS is a tab and read collapses runs of IFS whitespace, which would
# shift every later column.
#
# The last column is the Claude Code session id, if a Claude is running in the
# pane: the SessionStart hook in .claude/settings.json stores it as the pane
# option @claude_session and SessionEnd removes it. Restore does not run the
# agent — it TYPES `claude -r <id>` into the restored pane and leaves it unsent,
# so the reboot loop is one Enter instead of a hunt for which id belonged where
# (`claude -c` resumes "the latest in this cwd", which is ambiguous the moment
# two panes share a directory).
fmt=$(printf '#{session_name}\t#{window_index}\t#{?#{==:#{automatic-rename},1},~auto~,#{window_name}}\t#{window_layout}\t#{pane_index}\t#{pane_current_path}\t#{@claude_session}')

save() {
    # -f drops tmux 3.7's floating panes (prefix * upstream; unbound in
    # .tmux.conf). They are real panes, but one in a window appends a trailing
    # <...> section to #{window_layout} that select-layout rejects outright
    # with "invalid layout" — and restore() discards that error, so the window
    # would come back with its panes wherever the incremental tiled pass left
    # them. Recording the window without them restores the docked layout
    # faithfully; the floating pane itself is not restored, which is the same
    # bargain as not restoring commands.
    panes=$(tmux list-panes -a -f '#{!:#{pane_floating_flag}}' -F "$fmt" 2>/dev/null) || return 0
    [ -n "$panes" ] || return 0

    if [ "${1:-}" = auto ]; then
        # A scratch `-L` server shares this $HOME and loads this same conf. It
        # writes its own scoped file above, never the real one, and it has no
        # business autosaving at all. Note the polarity: an empty sock returns
        # here too, which is the safe direction — skip the save rather than
        # misfile it. Do not "fix" that to write.
        [ "$sock" = default ] || return 0

        # A server that has just come back from nothing is one session, one
        # window, one pane. Never record that shape.
        [ "$(printf '%s\n' "$panes" | wc -l)" -le 1 ] && return 0

        # One pane is not enough of a guard on its own. Two keystrokes after a
        # restart — one split, or C-a C — the server is bigger than that, and
        # the save then replaces a snapshot of ten sessions with one of one.
        # So: until this server is at least as big as the file already on
        # disk, treat it as a restart that has not been restored yet and
        # refuse to record it. Once it is, arm the server and autosave
        # normally — shrinking included — for the rest of its life, so a
        # deliberate `tkill` still gets recorded.
        #
        # Comparing session NAMES instead does not work here: `ta` names a
        # session after its repo directory, so `ta dotfiles` after a crash
        # reproduces a name the old snapshot already held and the guard falls
        # open on exactly the case it exists for.
        if [ "$(tmux show -sv @snapshot-armed 2>/dev/null)" != 1 ]; then
            if [ -f "$snap" ] &&
               [ "$(printf '%s\n' "$panes" | wc -l)" -lt "$(wc -l < "$snap")" ]; then
                return 0
            fi
            tmux set -s @snapshot-armed 1 2>/dev/null
        fi
    fi

    # Nothing changed since the last write: leave the file, and more
    # importantly leave .prev alone. Every hook in .tmux.conf fires this, and
    # rotating a good snapshot into .prev on each one would make the backup as
    # worthless as the thing it backs up.
    if [ -f "$snap" ] && [ "$panes" = "$(cat "$snap")" ]; then
        return 0
    fi

    mkdir -p "$state_dir" || return 1

    # An explicit save is you saying "this shape is the one", so it also
    # re-arms a server the guard above had frozen.
    [ "${1:-}" = auto ] || [ -z "$sock" ] || tmux set -s @snapshot-armed 1 2>/dev/null

    # Closing one session fires both session-closed and window-unlinked, so
    # two copies of this can reach the rotation at once and the cp is not
    # atomic. wait-for is tmux's own channel mutex, and it is server-scoped —
    # exactly the scope that matters. Skipped when there is no server to lock
    # against, where there is also no concurrency to guard.
    [ -n "$sock" ] && tmux wait-for -L snapshot 2>/dev/null
    # Release on signal death too. An orphaned channel locks every later save,
    # and client-detached's hook is un-backgrounded on purpose — it would hang
    # the detach. Installed after the lock so it can never free another saver's.
    trap 'tmux wait-for -U snapshot 2>/dev/null' EXIT INT TERM
    [ -f "$snap" ] && cp "$snap" "$snap.prev"
    printf '%s\n' "$panes" > "$snap.tmp" && mv "$snap.tmp" "$snap"
    [ -n "$sock" ] && tmux wait-for -U snapshot 2>/dev/null
    trap - EXIT INT TERM
    return 0
}

restore() {
    [ -f "$snap" ] || { tmux display-message "[tmux] no snapshot at $snap"; return 1; }

    # Size new sessions to the attached client. A detached session is 80x24 by
    # default, and select-layout silently reflows any layout that will not fit
    # — so a restore run without this comes back with the panes in the wrong
    # places and no error to explain it.
    w=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
    h=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)
    case $w in '' | 0 | *[!0-9]*) w=200 ;; esac
    case $h in '' | 0 | *[!0-9]*) h=50 ;; esac

    sorted=$(mktemp) || return 1
    trap 'rm -f "$sorted"' EXIT INT TERM
    # session, then window index, then pane index — all numeric where it counts
    sort -t"$tab" -k1,1 -k2,2n -k5,5n "$snap" > "$sorted"

    made=0 skipped=0 new_session=0 skip_session=0
    cur_s='' cur_w='' pending_win='' pending_layout='' last_pane='' sid=''
    while IFS="$tab" read -r s wi wn layout pi cwd cid; do
        [ -n "$s" ] || continue
        [ -d "$cwd" ] || cwd=$HOME
        # Only a UUID is ever typed into a pane. The snapshot file is plain
        # text any local process could append to, and what passes here is
        # typed onto a live command line one Enter away from running — so the
        # check is the full shape: 36 chars, hex and dashes only. (A glob
        # skeleton like [0-9a-f]*-… is NOT that: every * accepts spaces, ';'
        # and '$(…)', which a review demonstrated.)
        case $cid in
            *[!0-9a-f-]*) cid='' ;;
            ????????-????-????-????-????????????) ;;
            *) cid='' ;;
        esac
        # ~auto~ means "this window had automatic-rename on" — create it with
        # no -n at all, so tmux keeps naming it after what runs in it.
        [ "$wn" = '~auto~' ] && wn=''

        if [ "$s" != "$cur_s" ]; then
            cur_s=$s cur_w='' skip_session=0
            # -t= is an exact match; a plain -t would let "work" latch onto
            # an existing "work-scratch" and merge the two.
            if tmux has-session -t="$s" 2>/dev/null; then
                skip_session=1 skipped=$((skipped + 1))
                continue
            fi
            new_session=1
        fi
        [ "$skip_session" -eq 1 ] && continue

        if [ "$wi" != "$cur_w" ]; then
            [ -n "$pending_win" ] && tmux select-layout -t "$pending_win" "$pending_layout" >/dev/null 2>&1
            cur_w=$wi
            if [ "$new_session" -eq 1 ]; then
                # Create the session AS its first window rather than making a
                # placeholder and killing it later: killing the last window
                # kills the session, and a placeholder sitting on a real
                # window's index makes new-window pick a different one.
                #
                # Everything below targets the session by its ID, not its
                # name. ':' is tmux's own session:window separator, so a
                # session called "a:b" makes the target "a:b:2" parse as
                # session "a", and new-window fails with "can't find window:
                # b:2". A '$3' session id can never contain one.
                if [ -n "$wn" ]; then
                    out=$(tmux new-session -d -P -F '#{session_id} #{window_index} #{pane_id}' \
                        -s "$s" -n "$wn" -c "$cwd" -x "$w" -y "$h") || { skip_session=1; continue; }
                else
                    out=$(tmux new-session -d -P -F '#{session_id} #{window_index} #{pane_id}' \
                        -s "$s" -c "$cwd" -x "$w" -y "$h") || { skip_session=1; continue; }
                fi
                sid=${out%% *} last_pane=${out##* }
                got=${out#* } got=${got%% *}
                [ "$got" = "$wi" ] || tmux move-window -s "$sid:$got" -t "$sid:$wi" 2>/dev/null
                new_session=0 made=$((made + 1))
            else
                if [ -n "$wn" ]; then
                    last_pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$sid:$wi" -n "$wn" -c "$cwd" 2>/dev/null)
                else
                    last_pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$sid:$wi" -c "$cwd" 2>/dev/null)
                fi
                # A failed new-window leaves last_pane empty, and an empty -t
                # is not an error to tmux: it falls back to the CURRENT pane,
                # so every remaining pane of this window would be split into
                # whatever window you are sitting in. Drop the window instead.
                [ -n "$last_pane" ] || { pending_win=''; continue; }
            fi
            pending_win="$sid:$wi" pending_layout=$layout
            [ -n "$cid" ] && tmux send-keys -t "$last_pane" "claude -r $cid"
        else
            # Split the pane we made last, by id — NOT the window. split-window
            # targeting a window splits that window's *active* pane, and -d
            # leaves the first pane active, so every later pane lands directly
            # under pane 1 and the directories come back in the wrong slots.
            [ -n "$last_pane" ] || continue
            last_pane=$(tmux split-window -d -P -F '#{pane_id}' -t "$last_pane" -c "$cwd" 2>/dev/null) || continue
            [ -n "$last_pane" ] || continue
            [ -n "$cid" ] && tmux send-keys -t "$last_pane" "claude -r $cid"
            # Re-tile as we go: past four or five panes a default split has no
            # room left and fails, and the real layout only lands at the end.
            tmux select-layout -t "$pending_win" tiled >/dev/null 2>&1
        fi
    done < "$sorted"
    [ -n "$pending_win" ] && tmux select-layout -t "$pending_win" "$pending_layout" >/dev/null 2>&1

    # A restore is the shape you want kept, so stop the arm guard in save()
    # from freezing autosave on a server that has just been put back.
    [ -z "$sock" ] || tmux set -s @snapshot-armed 1 2>/dev/null

    tmux display-message "[tmux] restored $made session(s), skipped $skipped already open"
}

case "${1:-}" in
    save) save "${2:-}" ;;
    restore) restore ;;
    path) printf '%s\n' "$snap" ;;
    *) printf 'usage: %s save [auto] | restore | path\n' "${0##*/}" >&2; exit 2 ;;
esac
