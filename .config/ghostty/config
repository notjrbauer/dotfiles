# Ghostty config — mirrors .config/wezterm/* (colors/custom.lua, config/appearance.lua, config/fonts.lua)
# Target: Ghostty 1.3.1 (Mar 2026), macOS. Location: ~/.config/ghostty/config
# Palette: slightly-altered Catppuccin Mocha (base swapped to #1f1f28).
# Syntax verified against https://ghostty.org/docs/config/reference (1.3.x).

# ---------------------------------------------------------------------------
# Font  (fonts.lua: JetBrains Mono Semibold @ 14pt on macOS)
# ---------------------------------------------------------------------------
font-family = JetBrains Mono
font-style = SemiBold
font-size = 14
# wezterm: bold_brightens_ansi_colors = true
bold-is-bright = true
# wezterm: underline_thickness = '1.5pt' — Ghostty has no underline-thickness knob;
# adjust-underline-thickness takes an integer/percentage metric modifier instead:
adjust-underline-thickness = 1

# ---------------------------------------------------------------------------
# Colors  (colors/custom.lua)
# ---------------------------------------------------------------------------
background = #1f1f28
foreground = #cdd6f4

# ansi 0-7
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
# brights 8-15
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8
# indexed (custom.lua `indexed`)
palette = 16=#fab387
palette = 17=#f5e0dc

selection-background = #585b70
selection-foreground = #cdd6f4

# ---------------------------------------------------------------------------
# Cursor  (appearance.lua: BlinkingBlock + force_reverse_video_cursor = true)
# force_reverse_video_cursor wins over custom.lua's rosewater cursor in wezterm,
# so mirror the effective behavior: cursor inverts the cell.
# ---------------------------------------------------------------------------
cursor-style = block
cursor-style-blink = true
cursor-color = cell-foreground
cursor-text = cell-background
# If you'd rather have custom.lua's literal values instead of inversion:
# cursor-color = #f5e0dc
# cursor-text = #11111b
# NOT SUPPORTED: cursor_blink_rate / blink easing curves (wezterm 650ms EaseOut).
# Ghostty blink cadence follows the OS; only on/off is configurable.

# ---------------------------------------------------------------------------
# Background  (appearance.lua: backdrops module — random image, brightness 0.65
# overlay, opacity 0.90). Ghostty supports background images since 1.2.0.
# There is no HSB/brightness control on the image; approximate the dark overlay
# by blending the image against the background color via background-image-opacity.
# ---------------------------------------------------------------------------
background-opacity = 0.90
# background-blur = 20                       # optional; wezterm setup doesn't blur
# Point at one image (Ghostty can't cycle/randomize like utils/backdrops.lua;
# closest workaround: a login script that symlinks a random image to a fixed path,
# then `ghostty +reload-config` or the reload_config keybind action).
# background-image = ~/.config/wezterm/backdrops/YOUR_PICK.jpg
# background-image-fit = cover
# background-image-opacity = 0.35            # ~ backdrops' brightness 0.65 dark overlay
# background-image-repeat = false

# ---------------------------------------------------------------------------
# Window  (appearance.lua)
# ---------------------------------------------------------------------------
# window_padding: left/right 0, top 10, bottom 7.5 (Ghostty padding is integer points;
# x/y take a comma pair = leading,trailing i.e. top,bottom for y)
window-padding-x = 0
window-padding-y = 10,8
window-padding-balance = false
# initial_rows = 35, initial_cols = 100
window-height = 35
window-width = 100
# window_decorations = 'RESIZE' (no titlebar, still resizable)
macos-titlebar-style = hidden
# window_close_confirmation = 'NeverPrompt'
confirm-close-surface = false
# adjust_window_size_when_changing_font_size = false — Ghostty already keeps the
# window size fixed on font resize; no option needed.

# ---------------------------------------------------------------------------
# Tabs / splits  (appearance.lua: enable_tab_bar = false)
# Ghostty macOS tabs are NATIVE (no custom tab bar to draw or disable). The
# native tab bar only appears once a second tab exists, which matches the
# spirit of enable_tab_bar = false for a single-tab window.
# ---------------------------------------------------------------------------
# inactive_pane_hsb { brightness = 0.65 } ->
unfocused-split-opacity = 0.65
unfocused-split-fill = #1f1f28
# custom.lua split = overlay0
split-divider-color = #6c7086

# ---------------------------------------------------------------------------
# NOT SUPPORTED (wezterm-only), for the record:
# - Lua config / utils.gpu adapter picking (Ghostty: plain text; Metal is automatic on macOS)
# - max_fps / animation_fps caps (Ghostty renders on-demand, synced to display)
# - visual_bell fade animation + visual_bell color (custom.lua mocha.red);
#   Ghostty 1.3 has bell features (bell-features = attention,title) but no
#   colored screen/cursor flash.
# - scrollbar_thumb color (Ghostty 1.3 `scrollbar = system` uses native widgets)
# - compose_cursor color (mocha.flamingo)
# - per-tab-bar colors (custom.lua tab_bar block) — native macOS tabs follow the
#   system appearance; window-theme/background influence them but they are not
#   per-element themeable.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Leader-key parity (bindings.lua: CTRL-a leader + sticky resize_pane key table)
# Ghostty 1.3.0 added key tables + chained keybinds; sequences (a>b) existed before.
# Syntax: bindings live in a named table via `<table>/<binding>`; enter with
# activate_key_table:<name>, leave with deactivate_key_table.
# Example port of the sticky resize mode — uncomment to use without tmux:
# keybind = ctrl+a>r=activate_key_table:resize
# keybind = resize/h=resize_split:left,10
# keybind = resize/j=resize_split:down,10
# keybind = resize/k=resize_split:up,10
# keybind = resize/l=resize_split:right,10
# keybind = resize/escape=deactivate_key_table
# keybind = resize/q=deactivate_key_table
# keybind = resize/catch_all=deactivate_key_table   # any other key exits, like wezterm's until_unknown
# ---------------------------------------------------------------------------
