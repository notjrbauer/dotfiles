#!/bin/sh
# backdrop — pick a random background image for Ghostty.
# Port of .config/wezterm/utils/backdrops.lua `random()`. Ghostty has no native
# image cycling, so this writes a one-line config fragment that the main config
# pulls in via `config-file = ?~/.cache/ghostty/backdrop-image`.
#
# Usage: run `backdrop` (optionally with an image dir), then reload Ghostty
# with its reload_config keybind (default: super+shift+,) to apply.
set -eu

dir="${1:-$HOME/.config/wezterm/backdrops}"
out="$HOME/.cache/ghostty/backdrop-image"

# Ghostty 1.3 only decodes PNG and JPEG. srand() alone seeds from whole
# seconds, so feed it real entropy to vary within the same second.
pick=$(find "$dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) |
  awk -v seed="$(od -An -N4 -tu4 /dev/urandom | tr -d ' ')" \
    'BEGIN { srand(seed) } { a[NR] = $0 } END { if (NR > 0) print a[int(rand() * NR) + 1] }')

if [ -z "$pick" ]; then
  echo "backdrop: no png/jpg images found in $dir" >&2
  exit 1
fi

mkdir -p "${out%/*}"
printf 'background-image = %s\n' "$pick" >"$out"
echo "backdrop: $pick"
